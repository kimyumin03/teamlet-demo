# ─────────────────────────────────────────────────────────────
# Teamlet 환경 변수 (.env.example) — 복사해서 .env 로 사용
# 로컬 기본값은 docker/docker-compose.yml 기준
# ─────────────────────────────────────────────────────────────

# Database (Postgres 16 — pg_trgm / pg_bigm 확장 사용)
DATABASE_URL="postgresql://teamlet:teamlet@localhost:5432/teamlet?schema=public"

# Redis (BullMQ 큐 / EffectivePermission 캐시)
REDIS_URL="redis://localhost:6379"

# Auth.js v5
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Anthropic API (⌘K AI 자연어 명령 — Claude Haiku)
ANTHROPIC_API_KEY=""

# AxHub 연동 (옵션 — true 시 AxHub Adapter 구현체 사용, 기본 manual)
AXHUB_ENABLED="false"
AXHUB_API_URL=""
AXHUB_API_KEY=""

# S3 / MinIO (파일 저장)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="teamlet"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Email (React Email + Resend)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@teamlet.local"

# 시스템 관리자 (B2B 세일즈 — 회사 등록 신청 검토 권한)
SYSTEM_ADMIN_EMAILS="admin@example.com"

# 런타임
NODE_ENV="development"
