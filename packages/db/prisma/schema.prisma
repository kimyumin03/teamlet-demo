// Teamlet Prisma 스키마
// 단일 출처 — Kysely(prisma-kysely)도 이 스키마 참조 (docs/04 §1-3).
// Phase 1 (Foundation): 인증 · 멀티테넌시 · 가입흐름 · 조직 · 권한 · 감사로그.
// Phase 2~8 도메인은 하단 주석 placeholder (docs/03 참조).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../generated"
  fileName = "kysely-types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums (docs/04 §3-2: PascalCase 키 + SCREAMING_SNAKE 값)
// ─────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  DISPATCH
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  LEFT
}

enum JoinPath {
  APPLICATION
  INVITE
  COMPANY_CODE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompanyJoinPolicy {
  REQUIRE_APPROVAL
  OPEN
  INVITE_ONLY
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SECONDED
  RESIGNED
  SCHEDULED
}

/// 데이터 소스 추적 (docs/03 §3 — AxHub bulk 대응)
enum DataSource {
  MANUAL
  CSV_IMPORT
  AXHUB_API
}

/// 권한 그룹 유형 (docs/03 §7)
enum RoleType {
  SYSTEM_SUPER_ADMIN
  DYNAMIC_ORG_HEAD
  DEFAULT
  CUSTOM
}

enum PermissionAction {
  READ
  MANAGE
  EXECUTE
}

enum PermissionSensitivity {
  NORMAL
  SENSITIVE
  CRITICAL
}

/// 권한 범위 (docs/01 §5)
enum ScopeType {
  ALL
  DEPARTMENT
  DIRECT_REPORTS
  SELF
}

enum AuditEventType {
  CREATE
  READ
  UPDATE
  DELETE
  DOWNLOAD
}

enum LeaveGrantMethod {
  ON_REQUEST
  ON_OTHER_EXHAUSTED
  MANUAL
  ON_HIRE
  PERIODIC
  ON_TENURE
}

enum LeaveGrantUnit {
  MINUTE
  HOUR
  DAY
  UNLIMITED
}

enum LeavePaymentType {
  PAID
  UNPAID
  PARTIAL_PAID
}

enum LeaveGenderRestriction {
  ALL
  MALE
  FEMALE
}

enum LeaveEvidenceRequirement {
  NONE
  BEFORE
  AFTER
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CANCEL_PENDING // 승인 완료 휴가의 취소 승인 대기 (approveOnCancel)
}

enum LeaveTxCategory {
  MONTHLY
  ANNUAL
  EXTRA_GRANT
  ADJUSTMENT
}

enum FormDocumentKind {
  GENERAL
  LEAVE_REQUEST
  LEAVE_PLAN      // 연차 사용 계획 (촉진 응답 — 근로기준법 제61조 전자문서)
  INFO_CHANGE
  ANNOUNCEMENT
}

enum FormDocumentStatus {
  DRAFT
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalLineStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  DELEGATE
  CANCEL
}

enum JobPostingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum CandidateResult {
  IN_PROGRESS
  PASSED
  FAILED
  WITHDRAWN
}

enum LeaveTxType {
  GRANT
  EXPIRE
  USE
  ADJUST
}

enum LeavePolicyGrantMode {
  FISCAL_YEAR
  HIRE_DATE
}

enum MonthlyGrantRule {
  MONTHLY_ON_ATTENDANCE
  LUMP_SUM_ON_HIRE_11
  LUMP_SUM_UNTIL_FISCAL
}

enum AnnualFirstYearRule {
  PRORATED_ON_FIRST_FISCAL
  DAYS_15_ON_FIRST_FISCAL
  DAYS_15_ON_ANNIVERSARY
  LUMP_SUM_ON_HIRE_15
}

enum DecimalRule {
  ROUND_UP_DAY
  ROUND_UP_HALF
  NO_ADJUSTMENT
}

enum LeaveUseUnit {
  HOUR      // 시간 단위
  HALF_DAY  // 반차 단위
  DAY       // 일 단위
}

enum MonthlyExpiryMode {
  NONE                   // 소멸 안 함
  HIRE_DATE_1Y           // 입사일로부터 1년 후
  HIRE_DATE_1Y_FISCAL    // 입사일로부터 1년 후 첫 회계일
}

enum AnnualExpiryMode {
  NONE          // 소멸 안 함
  GRANT_DATE_1Y // 부여일로부터 1년 후
}

enum RetirementAdjustMode {
  EMPLOYEE_FAVORABLE // 구성원에게 유리한 기준
  LABOR_LAW          // 항상 근로기준법 기준
}

enum LeavePromotionType {
  ANNUAL       // 연차 (1년 이상 재직)
  MONTHLY_1ST  // 월차 1차 (1~9번째)
  MONTHLY_2ND  // 월차 2차 (10~11번째)
}

enum LeavePromotionStatus {
  REQUESTED         // 작성 요청됨
  ADMIN_WRITING     // 관리자 작성 기간
  APPROVAL_PENDING  // 승인 진행 중
  REJECTED          // 반려
  COMPLETED         // 완료
  EXPIRED           // 작성 기간 지남
  CANCELLED         // 촉진 취소
}

// ─────────────────────────────────────────────────────────────
// 인증 · 멀티 테넌시 (docs/03 §13)
// ─────────────────────────────────────────────────────────────

/// 인증 단위 — 회사 무관, 멀티 테넌시 루트
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  googleId      String?   @unique
  axhubUserId   String?   @unique
  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships        UserCompanyMembership[]
  companyApplications CompanyApplication[]   @relation("Applicant")
  reviewedApplications CompanyApplication[]  @relation("ApplicationReviewer")
  joinRequests       JoinRequest[]           @relation("JoinRequester")
  reviewedJoinReqs   JoinRequest[]           @relation("JoinReviewer")
  sentInvites        EmployeeInvite[]        @relation("Inviter")
  loginAttempts      LoginAttempt[]
  mfa                UserMFA?

  @@map("users")
}

model UserMFA {
  id        String    @id @default(cuid())
  userId    String    @unique
  secret    String    // TOTP secret (base32)
  isEnabled Boolean   @default(false)
  enabledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model Company {
  id               String            @id @default(cuid())
  name             String
  businessNumber   String            @unique
  corporateNumber  String?
  phone            String?
  foundedAt        DateTime?
  addressRoad      String?
  addressDetail    String?
  logoUrl          String?
  coverUrl         String?
  companyCode      String            @unique
  companyCodeActive Boolean          @default(true)
  joinPolicy       CompanyJoinPolicy @default(REQUIRE_APPROVAL)
  visionMission    String?
  isSetupCompleted Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  memberships   UserCompanyMembership[]
  departments   Department[]
  employees     Employee[]
  positions     Position[]
  roles         Role[]
  joinRequests  JoinRequest[]
  invites       EmployeeInvite[]
  loginPolicy   CompanyLoginPolicy?
  auditLogs     AuditLog[]
  leaveTypes      LeaveType[]
  companyHolidays CompanyHoliday[]
  formTemplates   FormTemplate[]
  formDocuments   FormDocument[]
  jobPostings       JobPosting[]
  companyDocuments  CompanyDocument[]
  securityPolicy    CompanySecurityPolicy?
  notifications     Notification[]
  leavePolicies     LeavePolicy[]
  leaveSettings     CompanyLeaveSettings?
  recognitions      Recognition[]
  appointments      Appointment[]
  announcements     Announcement[]
  approvalPolicies  ApprovalPolicy[]
  bulkOperations    BulkOperation[]
  // 신청 승인 시 생성된 회사 역참조
  fromApplication CompanyApplication? @relation("CreatedCompany")

  @@map("companies")
}

/// 다대다 — 멀티 테넌시 핵심 (User ↔ Company)
model UserCompanyMembership {
  id              String           @id @default(cuid())
  userId          String
  companyId       String
  employeeId      String?          @unique
  status          MembershipStatus @default(PENDING)
  joinPath        JoinPath
  appliedAt       DateTime         @default(now())
  activatedAt     DateTime?
  approvedByUserId String?
  isActive        Boolean          @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@map("user_company_memberships")
}

/// 회사 생성 신청 — Sales-led (docs/06 §1.3)
model CompanyApplication {
  id                 String            @id @default(cuid())
  applicantUserId    String
  companyName        String
  businessNumber     String
  representativeName String
  contact            String
  companySize        String
  industry           String
  memo               String?
  documentUrl        String?
  status             ApplicationStatus @default(PENDING)
  reviewerUserId     String?
  reviewedAt         DateTime?
  reviewMemo         String?
  createdCompanyId   String?           @unique
  createdAt          DateTime          @default(now())

  applicant User     @relation("Applicant", fields: [applicantUserId], references: [id])
  reviewer  User?    @relation("ApplicationReviewer", fields: [reviewerUserId], references: [id])
  createdCompany Company? @relation("CreatedCompany", fields: [createdCompanyId], references: [id])

  @@index([status, createdAt])
  @@map("company_applications")
}

/// 직원 가입 신청 — 회사코드 (docs/06 §1.2)
model JoinRequest {
  id             String            @id @default(cuid())
  userId         String
  companyId      String
  usedCompanyCode String
  payload        Json?
  status         ApplicationStatus @default(PENDING)
  reviewerUserId String?
  reviewedAt     DateTime?
  reviewMemo     String?
  createdAt      DateTime          @default(now())

  user      User    @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer  User?   @relation("JoinReviewer", fields: [reviewerUserId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, status, createdAt])
  @@map("join_requests")
}

/// HR 직접 초대 (docs/03 §13)
model EmployeeInvite {
  id            String    @id @default(cuid())
  companyId     String
  inviterUserId String
  email         String
  tokenHash     String    @unique
  expiresAt     DateTime
  prefilledData Json?
  used          Boolean   @default(false)
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User    @relation("Inviter", fields: [inviterUserId], references: [id])

  @@index([companyId, used])
  @@map("employee_invites")
}

// ─────────────────────────────────────────────────────────────
// 조직 (docs/03 §1)
// ─────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  employees Employee[]

  @@index([companyId, parentId])
  @@map("departments")
}

/// 직원 — 회사별 신분 (Phase 1은 최소 형태. 시점 이력은 Phase 2)
model Employee {
  id               String           @id @default(cuid())
  companyId        String
  departmentId     String?
  positionId       String?
  name             String
  employeeNumber   String?
  companyEmail     String?
  personalEmail    String?
  phone            String?
  birthDate        DateTime?
  gender           Gender?
  hireDate         DateTime?
  employmentType   EmploymentType   @default(FULL_TIME)
  probationEndDate DateTime?
  resignedAt       DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)
  // 데이터 소스 추적 (docs/03 §3 — AxHub bulk)
  dataSource       DataSource       @default(MANUAL)
  axhubExternalId  String?
  lastSyncedAt     DateTime?
  syncLockedFields String[]         @default([])
  bulkImportRowId  String?
  isActive         Boolean          @default(true)
  // 공지사항 마지막 확인 시각 — 이후 생성된 공지 수 = 읽지 않은 공지
  lastAnnouncementReadAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  membership UserCompanyMembership?
  userRoles  UserRole[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  leaveTransactions LeaveTransaction[] @relation("LeaveTransactions")
  actedTransactions LeaveTransaction[] @relation("LeaveTransactionActor")
  authoredDocuments FormDocument[]     @relation("AuthoredDocuments")
  approvalLines     ApprovalLine[]     @relation("ApprovalLines")
  approvalActions   ApprovalAction[]   @relation("ApprovalActions")
  ccDocuments       DocumentCcRecipient[] @relation("CcDocuments")
  announcements           Announcement[]             @relation("AuthoredAnnouncements")
  announcementComments    AnnouncementComment[]      @relation("AuthoredAnnouncementComments")
  managedPostings      JobPosting[]       @relation("ManagedPostings")
  managedCandidates    Candidate[]        @relation("ManagedCandidates")
  uploadedDocuments    CompanyDocument[]  @relation("UploadedDocuments")
  issuedCertificates   CertificateIssue[] @relation("IssuedCertificates")
  certificateIssuances CertificateIssue[] @relation("CertificateIssuers")
  notifications           Notification[]           @relation("ReceivedNotifications")
  leavePolicyAssignments  LeavePolicyAssignment[]
  appointments            Appointment[]
  careerHistories         CareerHistory[]
  educationHistories      EducationHistory[]
  familyMembers           FamilyMember[]
  // 휴가 승인선 (휴가 종류·연차 정책에 고정 지정된 승인자)
  leaveTypesAsApprover    LeaveType[]      @relation("LeaveTypeApprover")
  leavePoliciesAsApprover LeavePolicy[]    @relation("LeavePolicyApprover")
  leavePromotions         LeavePromotion[] @relation("EmployeeLeavePromotions")
  recognitionsSent        Recognition[]    @relation("RecognitionSender")
  recognitionsReceived    Recognition[]    @relation("RecognitionRecipient")
  bulkOperations          BulkOperation[]

  @@unique([companyId, axhubExternalId])
  @@index([companyId, employmentStatus])
  @@index([companyId, departmentId])
  @@index([companyId, positionId])
  @@map("employees")
}

/// 직책 (docs/03 §3 Position). 회사별 직책 목록. isOrgHead 는 DYNAMIC_ORG_HEAD 평가에 사용 (P3+).
model Position {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isOrgHead Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("positions")
}

/// 인사 발령 — 직원의 부서·직책 변경을 시점별 이력으로 기록 (docs/03 §1, Anti-Pattern #1).
/// Employee.departmentId / positionId 는 이 테이블의 최신 row 를 반영하는 비정규화 캐시.
/// 각 row 는 불변 — 변경은 항상 새 발령 추가. UPDATE 로 직책/부서를 덮어쓰지 않는다.
model Appointment {
  id                 String          @id @default(cuid())
  companyId          String
  employeeId         String
  kind               AppointmentKind
  effectiveDate      DateTime        // 발령일 (날짜 의미)
  fromDepartmentId   String?
  fromDepartmentName String?         // 발령 시점 라벨 스냅샷 (부서 개명·삭제 대비)
  toDepartmentId     String?
  toDepartmentName   String?
  fromPositionId     String?
  fromPositionName   String?
  toPositionId       String?
  toPositionName     String?
  memo               String?
  appointedById      String?         // 발령 처리자 (Employee.id)
  appointedByName    String?
  createdAt          DateTime        @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, effectiveDate])
  @@map("appointments")
}

enum AppointmentKind {
  HIRE            // 입사 (최초 배정)
  TRANSFER        // 부서 이동
  PROMOTION       // 승진
  POSITION_CHANGE // 직책 변경
  REASSIGN        // 부서·직책 동시 변경
}

// ─────────────────────────────────────────────────────────────
// 권한 — RBAC + Scope (docs/03 §7)
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  icon        String?
  type        RoleType
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

/// 권한 마스터 — 전역 단일 카탈로그 (~70개, 시드)
model Permission {
  id                  String                @id @default(cuid())
  key                 String                @unique
  category            String
  domain              String
  action              PermissionAction
  name                String
  description         String?
  sensitivity         PermissionSensitivity @default(NORMAL)
  hasScope            Boolean               @default(false)
  dependsOnPermissionKeys String[]          @default([])
  warningText         String?

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id                    String     @id @default(cuid())
  roleId                String
  permissionId          String
  enabled               Boolean    @default(true)
  scopeType             ScopeType?
  departmentIds         String[]   @default([])
  includeSubDepartments Boolean    @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id               String   @id @default(cuid())
  employeeId       String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?
  isActive         Boolean  @default(true)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([employeeId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────
// 보안 (Phase 1 기본형 — docs/03 §8)
// ─────────────────────────────────────────────────────────────

model CompanyLoginPolicy {
  id                      String  @id @default(cuid())
  companyId               String  @unique
  minLength               Int     @default(8)
  requireAlpha            Boolean @default(true)
  requireDigit            Boolean @default(true)
  requireSpecial          Boolean @default(true)
  blockWeakPasswords      Boolean @default(true)
  blockPersonalInfo       Boolean @default(true)
  preventReuseCount       Int     @default(3)
  passwordExpiryDays      Int?
  maxLoginAttempts        Int     @default(5)
  pcSessionMaxAgeHours    Int     @default(168)
  mobileSessionMaxAgeHours Int    @default(720)
  allowLeaveOfAbsenceLogin Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_login_policies")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  userId      String?
  attemptedAt DateTime @default(now())
  ip          String?
  userAgent   String?
  success     Boolean
  failReason  String?

  user User? @relation(fields: [userId], references: [id])

  @@index([email, attemptedAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────
// 감사 로그 (Phase 1 기본형: actor/event/target/before-after — docs/03 §9)
// 정보 분류 강화(InfoCategory/FieldClassification)는 Phase 6.
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id              String         @id @default(cuid())
  companyId       String?
  occurredAt      DateTime       @default(now())
  actorUserId     String?
  actorEmail      String?
  actorName       String?
  onBehalfOfUserId String?
  activityType    String
  eventType       AuditEventType
  targetType      String
  targetId        String?
  targetLabel     String?
  description     String
  beforeSnapshot  Json?
  afterSnapshot   Json?
  diff            Json?
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  requestId       String?

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — 휴가 (docs/03 §4)
// ─────────────────────────────────────────────────────────────

/// 회사별 휴가 종류. is_system=true 는 법정 8종 (비활성화만 가능, 삭제 불가).
model LeaveType {
  id                   String                  @id @default(cuid())
  companyId            String
  key                  String
  name                 String
  description          String                  @default("")
  isSystem             Boolean                 @default(false)
  isRequired           Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  grantMethod          LeaveGrantMethod        @default(ON_REQUEST)
  grantUnit            LeaveGrantUnit          @default(DAY)
  grantAmount          Decimal?
  paymentType          LeavePaymentType        @default(PAID)
  genderRestriction    LeaveGenderRestriction  @default(ALL)
  evidenceRequirement  LeaveEvidenceRequirement @default(NONE)
  // 사용 단위 (한번에 모두 / 나눠서: 일·반차·시간)
  useUnit              LeaveUseUnit            @default(DAY)
  // 시간차 사용 최소 단위(분) — useUnit = HOUR 일 때. null = 제한 없음
  hourUnitMinutes      Int?
  // 일부 유급 % (paymentType = PARTIAL_PAID 일 때) — 레거시
  partialPayPercent    Int?
  // 일부 유급 일수 (Flex 방식: 유급으로 인정하는 일수. 예 출산전후 60일, 난임 2일)
  partialPayDays       Int?
  // 휴가 기간에 휴일이 포함된 경우 휴일도 차감하는지
  deductOnHoliday      Boolean                 @default(false)
  // 주기 부여 옵션 — 반복 부여 주기 / 근속 시 부여 연수
  periodicCycle        String?
  tenureYears          Int?
  // 제외 대상 (근로유형·조직)
  excludedEmploymentTypes String[]             @default([])
  excludedDepartmentIds   String[]             @default([])
  // 승인·참조 설정 (맞춤 휴가 설정에서 지정 — 신청 시 자동 적용·고정)
  approverEmployeeId   String?                 // null = 승인 불필요
  ccEmployeeIds        String[]                @default([]) // 참조자
  // 승인 요청 시점 — 등록 시 승인(기본) / 취소 시 승인(취소 승인 워크플로우)
  approveOnRegister    Boolean                 @default(true)
  approveOnCancel      Boolean                 @default(false)
  sortOrder            Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approver          Employee?         @relation("LeaveTypeApprover", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  leaveTransactions LeaveTransaction[]
  leavePolicies     LeavePolicy[]

  @@unique([companyId, key])
  @@index([companyId, isActive])
  @@map("leave_types")
}

/// 직원별·종류별 연도 잔여 캐시 (조회 최적화).
model LeaveBalance {
  id            String   @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  year          Int
  grantedDays   Decimal  @default(0)
  usedDays      Decimal  @default(0)
  adjustedDays  Decimal  @default(0)
  // 연차 소멸·이월 처리 멱등 마커 — set 되면 해당 연도 잔액은 이미 처리됨 (재실행 시 skip)
  expiryProcessedAt DateTime?
  updatedAt     DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
  @@map("leave_balances")
}

/// 휴가 신청.
model LeaveRequest {
  id          String             @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  days        Decimal
  reason      String             @default("")
  // 사용 단위 — FULL(하루종일)/AM_HALF(오전반차)/PM_HALF(오후반차)/HOURLY(시간차)
  unitType    String             @default("FULL")
  startTime   String?            // 시간차/반차 시작 (HH:mm)
  endTime     String?            // 시간차/반차 종료 (HH:mm)
  // 날짜별 상세 일정 (flexv2 #10~13) — 다일 휴가에서 날짜마다 단위 개별 지정.
  // [{ date:"YYYY-MM-DD", unit:"FULL|AM_HALF|PM_HALF|HOURLY", startTime?, endTime?, days:number }]
  // 비어있으면 unitType/startTime/endTime(대표값)으로 균일 적용.
  schedule    Json               @default("[]")
  evidenceFileUrl String?        // 증명 자료 업로드 URL
  status      LeaveRequestStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  // 통합 결재 인프라 링크 — 휴가 신청은 FormDocument(LEAVE_REQUEST) 결재선을 거친다.
  formDocumentId String?         @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType         LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leaveTransactions LeaveTransaction[]
  formDocument      FormDocument?      @relation(fields: [formDocumentId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — 공휴일 + 휴가 원장 (docs/03 §4)
// ─────────────────────────────────────────────────────────────

/// 회사 공휴일 (법정 + 자체). 휴가 일수 계산 시 영업일에서 제외.
model CompanyHoliday {
  id         String   @id @default(cuid())
  companyId  String
  date       DateTime @db.Date
  name       String
  isNational Boolean  @default(true)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@map("company_holidays")
}

/// 인정·피드백 — 개인 간 메시지(공용 아님). 수신자 본인만 확인.
enum RecognitionKind {
  RECOGNITION // 인정
  FEEDBACK    // 피드백
}

model Recognition {
  id          String          @id @default(cuid())
  companyId   String
  senderId    String          // 보낸 사람 (Employee)
  recipientId String          // 받는 사람 (Employee) — 본인만 확인
  kind        RecognitionKind @default(RECOGNITION)
  message     String
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender    Employee @relation("RecognitionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient Employee @relation("RecognitionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([companyId, recipientId, createdAt])
  @@map("recognitions")
}

/// 휴가 변동 이력 — 불변 원장. 부여/소멸/사용/조정 모두 기록.
model LeaveTransaction {
  id             String          @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  occurredAt     DateTime        @default(now())
  category       LeaveTxCategory
  txType         LeaveTxType
  days           Decimal
  reason         String          @default("")
  note           String?
  actorId        String?
  leaveRequestId String?

  employee     Employee      @relation("LeaveTransactions", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  actor        Employee?     @relation("LeaveTransactionActor", fields: [actorId], references: [id])

  /// 맞춤휴가 부여 건의 사용 가능 기간 (GRANT 트랜잭션 전용, null = 언제든 사용 가능)
  usableFrom   DateTime?     @db.Date
  usableUntil  DateTime?     @db.Date

  @@index([employeeId, leaveTypeId])
  @@index([leaveRequestId])
  @@map("leave_transactions")
}

/// 연차 부여 정책 (docs/03 §5 LeavePolicy).
model LeavePolicy {
  id                  String               @id @default(cuid())
  companyId           String
  name                String
  leaveTypeId         String
  grantMode           LeavePolicyGrantMode @default(FISCAL_YEAR)
  fiscalStartMonth    Int                  @default(1)
  monthlyGrantRule    MonthlyGrantRule     @default(MONTHLY_ON_ATTENDANCE)
  annualFirstYearRule AnnualFirstYearRule  @default(PRORATED_ON_FIRST_FISCAL)
  decimalRule         DecimalRule          @default(ROUND_UP_DAY)
  expiryMonths        Int                  @default(12)
  carryoverMaxDays    Decimal?
  // 부여 시작일
  grantStartDate      DateTime?            @db.Date
  // 연차 사용 단위 (시간/반차/일) + 시간 단위 분(시간 선택 시 1·5·10·15·20·30·60·120)
  useUnit             LeaveUseUnit         @default(HALF_DAY)
  hourUnitMinutes     Int?
  // 당겨쓰기 — 제한 없으면 overdraftMaxDays = null
  overdraftEnabled    Boolean              @default(false)
  overdraftMaxDays    Int?
  // 월차·연차 자동 소멸 (분리 + 유예)
  monthlyExpiryMode   MonthlyExpiryMode    @default(HIRE_DATE_1Y)
  monthlyGraceMonths  Int?
  annualExpiryMode    AnnualExpiryMode     @default(GRANT_DATE_1Y)
  annualGraceMonths   Int?
  // 승인 요청 시점
  approveOnRegister   Boolean              @default(true)
  approveOnCancel     Boolean              @default(false)
  // 정책 승인선 (연차 신청 시 적용)
  approverEmployeeId  String?
  ccEmployeeIds       String[]             @default([])
  // 스마트 연차 촉진 사용
  smartPromotionEnabled Boolean            @default(false)
  isDefault           Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveType   LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approver    Employee?                @relation("LeavePolicyApprover", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  assignments LeavePolicyAssignment[]

  @@index([companyId, isActive])
  @@map("leave_policies")
}

/// 직원별 정책 배정 이력.
model LeavePolicyAssignment {
  id            String   @id @default(cuid())
  employeeId    String
  policyId      String
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([policyId])
  @@map("leave_policy_assignments")
}

/// 회사 단위 휴가 설정 (퇴직자 조정 기준 + 연차 촉진 설정). 회사당 1행.
model CompanyLeaveSettings {
  id        String @id @default(cuid())
  companyId String @unique
  // 퇴직자 연차 조정 기준
  retirementAdjustMode RetirementAdjustMode @default(EMPLOYEE_FAVORABLE)
  // 연차 촉진 설정
  promotionApproverEmployeeId String?
  promotionCcEmployeeIds      String[] @default([])
  memberRemindEnabled         Boolean  @default(false) // 구성원 작성 리마인드
  adminRemindEnabled          Boolean  @default(false) // 관리자 작성 리마인드
  planNoticeDaysBefore        Int      @default(10)     // 사용 계획일 N일 전 알림 (1·3·5·7·10)
  // 스마트 촉진 시점 (소멸 N개월 전 + offsetDays)
  annualPromotionMonthsBefore   Int @default(6)
  annualPromotionOffsetDays     Int @default(0)
  monthly1stPromotionMonthsBefore Int @default(3)
  monthly1stPromotionOffsetDays   Int @default(0)
  monthly2ndPromotionMonthsBefore Int @default(1)
  monthly2ndPromotionOffsetDays   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_leave_settings")
}

/// 연차·월차 촉진 (근로기준법 제61조). worker 스케줄러가 자동 생성.
model LeavePromotion {
  id            String                @id @default(cuid())
  employeeId    String
  year          Int
  promotionType LeavePromotionType    // 연차 / 월차 1차 / 월차 2차
  targetDays    Decimal               // 촉진 대상 일수 (월차 2차는 10~11번째분만)
  expiryDate    DateTime              @db.Date // 법정 소멸일
  status        LeavePromotionStatus  @default(REQUESTED)
  requestedAt   DateTime              @default(now()) // 촉구 시점
  submittedAt   DateTime?             // 구성원 제출 시점
  approvedAt    DateTime?
  // 사용 계획 문서 (통합 결재 인프라 — 전자문서 법적효력)
  formDocumentId String?              @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  employee     Employee                   @relation("EmployeeLeavePromotions", fields: [employeeId], references: [id], onDelete: Cascade)
  formDocument FormDocument?              @relation(fields: [formDocumentId], references: [id], onDelete: SetNull)
  planDates    LeavePromotionPlanDate[]

  @@index([employeeId, year])
  @@index([status])
  @@map("leave_promotions")
}

/// 연차 사용 계획 — 사용 희망일 (촉진 1건당 N개).
model LeavePromotionPlanDate {
  id          String   @id @default(cuid())
  promotionId String
  planDate    DateTime @db.Date
  createdAt   DateTime @default(now())

  promotion LeavePromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("leave_promotion_plan_dates")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — 워크플로우 (docs/03 §4)
// ─────────────────────────────────────────────────────────────

/// 양식 템플릿 — 결재 문서 유형 정의.
model FormTemplate {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  kind        FormDocumentKind @default(GENERAL)
  description String           @default("")
  fields      Json             @default("[]")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents FormDocument[]

  @@index([companyId, isActive])
  @@map("form_templates")
}

/// 작성된 결재 문서.
model FormDocument {
  id         String             @id @default(cuid())
  companyId  String
  templateId String?
  authorId   String
  title      String
  kind       FormDocumentKind   @default(GENERAL)
  formData   Json               @default("{}")
  status     FormDocumentStatus @default(DRAFT)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template      FormTemplate?  @relation(fields: [templateId], references: [id])
  author        Employee       @relation("AuthoredDocuments", fields: [authorId], references: [id])
  approvalLines ApprovalLine[]
  actions       ApprovalAction[]
  leaveRequest  LeaveRequest?
  leavePromotion LeavePromotion?
  ccRecipients  DocumentCcRecipient[]

  @@index([companyId, status])
  @@index([authorId, status])
  @@map("form_documents")
}

/// 결재 문서 참조자 (열람만, 결재 권한 없음).
model DocumentCcRecipient {
  id         String   @id @default(cuid())
  documentId String
  employeeId String
  createdAt  DateTime @default(now())

  document   FormDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee   Employee     @relation("CcDocuments", fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
  @@index([employeeId])
  @@map("document_cc_recipients")
}

/// 결재 단계 인스턴스 (문서별 순서대로 생성).
model ApprovalLine {
  id         String            @id @default(cuid())
  documentId String
  step       Int
  approverId String
  status     ApprovalLineStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime          @default(now())

  document   FormDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver   Employee         @relation("ApprovalLines", fields: [approverId], references: [id])
  actions    ApprovalAction[]

  @@unique([documentId, step])
  @@index([approverId, status])
  @@map("approval_lines")
}

/// 결재 처리 이력 (immutable).
model ApprovalAction {
  id         String             @id @default(cuid())
  documentId String
  lineId     String
  actorId    String
  action     ApprovalActionType
  comment    String?
  createdAt  DateTime           @default(now())

  document FormDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  line     ApprovalLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  actor    Employee     @relation("ApprovalActions", fields: [actorId], references: [id])

  @@index([documentId])
  @@map("approval_actions")
}

// ─────────────────────────────────────────────────────────────
// Phase 5 — 채용 (docs/03 §5)
// ─────────────────────────────────────────────────────────────

/// 채용 공고.
model JobPosting {
  id          String           @id @default(cuid())
  companyId   String
  managerId   String
  title       String
  description String           @default("")
  status      JobPostingStatus @default(DRAFT)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager    Employee     @relation("ManagedPostings", fields: [managerId], references: [id])
  stages     JobStage[]
  candidates Candidate[]

  @@index([companyId, status])
  @@map("job_postings")
}

/// 전형 단계.
model JobStage {
  id        String   @id @default(cuid())
  postingId String
  order     Int
  name      String
  createdAt DateTime @default(now())

  posting    JobPosting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  candidates Candidate[] @relation("CurrentStage")

  @@unique([postingId, order])
  @@map("job_stages")
}

/// 후보자.
model Candidate {
  id             String          @id @default(cuid())
  postingId      String
  managerId      String?
  name           String
  email          String
  phone          String?
  currentStageId String?
  result         CandidateResult @default(IN_PROGRESS)
  answers        Json            @default("{}")
  appliedAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  posting      JobPosting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  currentStage JobStage?   @relation("CurrentStage", fields: [currentStageId], references: [id])
  manager      Employee?   @relation("ManagedCandidates", fields: [managerId], references: [id])

  @@index([postingId, result])
  @@map("candidates")
}

// ─────────────────────────────────────────────────────────────
// Phase 6 — 문서·증명서 (docs/03 §6)
// ─────────────────────────────────────────────────────────────

enum CompanyDocumentCategory {
  GENERAL
  NOTICE
  POLICY
}

enum CertificateType {
  EMPLOYMENT
  CAREER
}

/// 회사 공용 문서 보관소.
model CompanyDocument {
  id          String                  @id @default(cuid())
  companyId   String
  uploadedById String
  title       String
  category    CompanyDocumentCategory @default(GENERAL)
  fileUrl     String
  isPublic    Boolean                 @default(true)
  createdAt   DateTime                @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy Employee @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([companyId, category])
  @@map("company_documents")
}

/// 증명서 발급 이력.
model CertificateIssue {
  id           String          @id @default(cuid())
  employeeId   String
  issuerId     String
  type         CertificateType
  issueNumber  String          @unique
  purpose      String
  snapshotData Json
  createdAt    DateTime        @default(now())

  employee Employee @relation("IssuedCertificates", fields: [employeeId], references: [id])
  issuer   Employee @relation("CertificateIssuers", fields: [issuerId], references: [id])

  @@index([employeeId])
  @@map("certificate_issues")
}

// ─────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────
// Phase 7 — 보안 정책 (docs/03 §8)
// ─────────────────────────────────────────────────────────────

enum MfaMethod {
  OTP
  SMS
  EMAIL
}

/// 회사 보안·인증 정책 (회사 단일).
model CompanySecurityPolicy {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  mfaEnabled            Boolean   @default(false)
  mfaMethod             MfaMethod @default(OTP)
  mfaExemptIps          String[]  @default([])
  ipRestrictionEnabled  Boolean   @default(false)
  allowedIps            String[]  @default([])
  applyToSuperAdmin     Boolean   @default(false)
  updatedAt             DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_security_policies")
}

// ─────────────────────────────────────────────────────────────
// Phase 8 — 알림 시스템 (docs/03 §14)
// ─────────────────────────────────────────────────────────────

enum NotificationCategory {
  APPROVAL
  LEAVE
  HR
  ANNOUNCEMENT
  SYSTEM_SECURITY
}

/// 인앱 알림.
model Notification {
  id                String               @id @default(cuid())
  companyId         String
  recipientEmployeeId String
  category          NotificationCategory
  eventKey          String
  title             String
  body              String
  deepLink          String?
  relatedTargetType String?
  relatedTargetId   String?
  isRead            Boolean              @default(false)
  readAt            DateTime?
  createdAt         DateTime             @default(now())
  expiresAt         DateTime?

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipient Employee @relation("ReceivedNotifications", fields: [recipientEmployeeId], references: [id], onDelete: Cascade)

  @@index([recipientEmployeeId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// 회사 공지사항.
model Announcement {
  id        String   @id @default(cuid())
  companyId String
  authorId  String
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author   Employee              @relation("AuthoredAnnouncements", fields: [authorId], references: [id])
  comments AnnouncementComment[]

  @@index([companyId, isPinned, createdAt(sort: Desc)])
  @@map("announcements")
}

/// 공지사항 댓글.
model AnnouncementComment {
  id             String   @id @default(cuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       Employee     @relation("AuthoredAnnouncementComments", fields: [authorId], references: [id])

  @@index([announcementId, createdAt])
  @@map("announcement_comments")
}

// ─────────────────────────────────────────────────────────────
// 결재 정책 — 문서 종류별 자동 결재선 설정
// ─────────────────────────────────────────────────────────────

enum ApproverType {
  SPECIFIC_PERSON  // 특정 인물 (approverId 필수)
  DIRECT_MANAGER   // 직속 상관 (동적)
  DEPARTMENT_HEAD  // 부서장 (동적)
  ORG_HEAD         // 조직장 (동적)
}

/// 문서 종류별 결재 정책.
model ApprovalPolicy {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  category    FormDocumentKind @default(GENERAL)
  description String           @default("")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps   ApprovalPolicyStep[]

  @@index([companyId, isActive])
  @@map("approval_policies")
}

/// 결재 정책 단계별 결재자.
model ApprovalPolicyStep {
  id           String       @id @default(cuid())
  policyId     String
  step         Int
  approverType ApproverType @default(SPECIFIC_PERSON)
  approverId   String?

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, step])
  @@map("approval_policy_steps")
}

