// ─────────────────────────────────────────────────────────────
// Phase 7 — 구성원 확장 프로필 (경력/교육/가족)
// ─────────────────────────────────────────────────────────────

enum EducationDegree {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTOR
  ETC
}

/// 구성원 경력 사항
model CareerHistory {
  id          String    @id @default(cuid())
  employeeId  String
  companyName String
  position    String
  department  String    @default("")
  startDate   DateTime
  endDate     DateTime?
  description String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("career_histories")
}

/// 구성원 학력 사항
model EducationHistory {
  id           String          @id @default(cuid())
  employeeId   String
  schoolName   String
  major        String          @default("")
  degree       EducationDegree @default(BACHELOR)
  enrollDate   DateTime
  graduateDate DateTime?
  description  String          @default("")
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("education_histories")
}

/// 구성원 가족 사항
model FamilyMember {
  id           String    @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  birthDate    DateTime?
  isDependent  Boolean   @default(false)
  gender       Gender?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("family_members")
}

// ─────────────────────────────────────────────────────────────
// 벌크 처리 인프라 (Anti-Pattern #11 — createMany 직접 호출 금지)
// ─────────────────────────────────────────────────────────────

enum BulkOperationType {
  LEAVE_GRANT_IMPORT
  LEAVE_USAGE_IMPORT
  EMPLOYEE_CREATE
}

enum BulkOperationStatus {
  PENDING
  PROCESSING
  DONE
  PARTIAL
  FAILED
}

enum BulkRowStatus {
  PENDING
  SUCCESS
  SKIPPED
  FAILED
}

model BulkOperation {
  id          String              @id @default(cuid())
  companyId   String
  type        BulkOperationType
  status      BulkOperationStatus @default(PENDING)
  actorId     String
  totalRows   Int                 @default(0)
  successRows Int                 @default(0)
  failedRows  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   Employee @relation(fields: [actorId], references: [id])
  rows    BulkOperationRow[]

  @@index([companyId, type])
  @@index([actorId])
  @@map("bulk_operations")
}

model BulkOperationRow {
  id          String        @id @default(cuid())
  operationId String
  rowIndex    Int
  rawData     Json
  status      BulkRowStatus @default(PENDING)
  error       String?
  createdAt   DateTime      @default(now())

  operation BulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, rowIndex])
  @@map("bulk_operation_rows")
}
